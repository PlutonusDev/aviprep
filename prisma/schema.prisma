generator client {
    provider    = "prisma-client-js"
    engineType  = "binary"
}

datasource db {
    provider    = "mongodb"
    url         = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  email                 String    @unique
  passwordHash          String
  arn                   String    @unique // Aviation Reference Number
  firstName             String
  lastName              String
  phone                 String    // Australian phone number format
  stripeCustomerId      String?   @unique // Stripe customer ID for payments
  isAdmin               Boolean   @default(false)
  /// Set when a curator links this account to join the community, so the
  /// forums and messages can badge them without a second lookup per post.
  isCurator             Boolean?
  /// Their highest credential, e.g. "Grade 1 FI". Kept in step by
  /// lib/curators/community.ts whenever their credentials change.
  curatorCredential     String?
  profilePicture        String?   // URL to profile picture
  isSuspendedFromForum  Boolean   @default(false) // Forum posting suspension
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  // Subscription status
  hasBundle         Boolean   @default(false)
  bundleExpiry      DateTime?

  // Subjects this student's school has granted them directly. Kept apart from
  // Purchase, which records money changing hands.
  schoolSubjectIds    String[]      @default([])

  // When the welcome tour was finished or skipped. Null means never shown.
  onboardedAt         DateTime?

  // When the mobile number was confirmed by SMS code. Null for accounts made
  // before verification existed, or created by a school.
  phoneVerifiedAt     DateTime?
  // When the email address was confirmed from the link we send. Unverified
  // members can still use the site; they just see a reminder banner.
  emailVerifiedAt     DateTime?
  // Last verification email sent, for the resend cooldown.
  emailVerificationSentAt DateTime?

  // New sign-ups may unlock one subject free (app/api/user/free-subject).
  // Optional so existing accounts read as null = not eligible.
  freeSubjectEligible Boolean?
  freeSubjectId       String?
  // Set when the member confirms a closure request by SMS; support actions it.
  deletionRequestedAt DateTime?

  flightSchoolId      String?       @db.ObjectId
  flightSchool        FlightSchool? @relation ("FlightSchoolStudents", fields: [flightSchoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isFlightSchoolAdmin Boolean       @default(false)
  managedSchool       FlightSchool? @relation ("FlightSchoolAdmin")
  enrolledAt          DateTime?
  
  // Relations
  purchases         Purchase[]
  examAttempts      ExamAttempt[]
  weakPoints        WeakPoint[]
  studySessions     StudySession[]

  // Forum relations
  threads           Thread[]  @relation("ThreadAuthor")
  posts             Post[]    @relation("PostAuthor")
  reactions         Reaction[]
  messagesSent      PrivateMessage[] @relation("MessagesSent")
  messagesReceived  PrivateMessage[] @relation("MessagesReceived")
}

model FlightSchool {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String    @unique
  email           String    @unique
  phone           String?
  address         String?
  city            String?
  state           String?
  postcode        String?
  website         String?
  logo            String?

  /// The person who set the school up. They can never be removed from it.
  adminId         String    @unique @db.ObjectId
  admin           User      @relation("FlightSchoolAdmin", fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Other instructors invited into the school panel (lib/school/access.ts).
  /// They have the same access as the owner apart from removing people.
  instructorIds   String[]  @db.ObjectId

  isActive        Boolean   @default(true)
  maxStudents     Int       @default(50)

  subdomain       String?   @unique
  customDomain    String?   @unique
  primaryColour   String    @default("#0ea5e9")
  accentColour    String    @default("#f97316")
  favicon         String?
  loginBackground String?
  welcomeMessage  String?
  footerText      String?
  hideBranding    Boolean @default(false)

  // Feature keys the school has switched off for its students.
  // See lib/tenant-features.ts for the registry of valid keys.
  disabledFeatures String[] @default([])

  apiKey          String?   @unique
  apiEnabled      Boolean   @default(true)
  webhookUrl      String?
  webhookSecret   String?

  subscriptionTier    String  @default("basic")
  subscriptionExpiry  DateTime?

  students        User[]    @relation("FlightSchoolStudents")

  studentGroups   StudentGroup[]

  schoolPurchases SchoolPurchase[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StudentGroup {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  color       String    @default("#3b82f6")

  flightSchoolId  String  @db.ObjectId
  flightSchool    FlightSchool @relation(fields: [flightSchoolId], references: [id], onDelete: Cascade)

  studentIds  String[]  @db.ObjectId

  // Subjects every member of this group can see.
  subjectIds  String[]  @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flightSchoolId])
}

/// An invitation for another instructor to join a school's panel. Mirrors
/// CuratorInvite: the emailed token is never stored, only its hash.
model SchoolInvite {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  flightSchoolId String    @db.ObjectId
  email          String
  firstName      String?
  lastName       String?
  /// Optional personal note shown in the email and on the join page.
  note           String?
  tokenHash      String    @unique
  invitedById    String    @db.ObjectId
  expiresAt      DateTime
  sentAt         DateTime  @default(now())
  sendCount      Int       @default(1)
  acceptedAt     DateTime?
  revokedAt      DateTime?
  /// The User who accepted it.
  userId         String?   @db.ObjectId
  createdAt      DateTime  @default(now())

  @@index([flightSchoolId])
  @@index([email])
}

model SchoolPurchase {
  id        String    @id @default(auto()) @map("_id")  @db.ObjectId

  flightSchoolId  String  @db.ObjectId
  flightSchool    FlightSchool  @relation(fields: [flightSchoolId], references: [id], onDelete: Cascade)

  licenseType     String
  productType     String
  subjectId       String?
  tier            String

  totalSeats      Int
  usedSeats       Int   @default(0)

  pricePerSeat    Int
  totalPrice      Int

  purchasedAt     DateTime  @default(now())
  expiresAt       DateTime

  stripePaymentId String?

  @@index([flightSchoolId])
}

model Purchase {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subjectId    String   // e.g., "aero", "met", "nav"
  subjectName  String
  subjectCode  String
  
  purchaseType String   // "individual" or "bundle"
  priceAud     Int      // Price in cents
  
  // Add-ons for individual purchases
  hasPrinting  Boolean  @default(false)
  hasAiInsights Boolean @default(false)
  
  purchasedAt  DateTime @default(now())
  expiresAt    DateTime
  
  // Stripe payment reference
  stripePaymentId String?
  stripeCustomerId String?
  
  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
}

model ExamAttempt {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subjectId       String
  subjectName     String
  
  score           Int      // Percentage
  totalQuestions  Int
  correctAnswers  Int
  timeSpentMins   Int
  passed          Boolean
  
  // Detailed results stored as JSON
  questionResults Json     // Array of { questionId, answeredCorrectly, timeTaken }
  
  completedAt     DateTime @default(now())
  
  @@index([userId])
  @@index([subjectId])
  @@index([completedAt])
}

model WeakPoint {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  topic              String
  subjectId          String
  subjectName        String
  
  accuracy           Int      // Percentage
  questionsAttempted Int
  recommendation     String
  priority           String   // "high", "medium", "low"
  
  updatedAt          DateTime @updatedAt
  
  @@unique([userId, topic, subjectId])
  @@index([userId])
}

model StudySession {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subjectId   String?
  durationMins Int
  
  startedAt   DateTime
  endedAt     DateTime
  
  @@index([userId])
  @@index([startedAt])
}

model Subject {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  subjectId       String @unique // "aero", "met", etc.
  name            String
  code            String
  description     String
  totalQuestions  Int
  icon            String
  priceAud        Int    // Price in cents
}

model Question {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  subjectId    String
  topic        String
  difficulty   String // "easy", "medium", "hard"
  
  questionText String
  /// A chart, diagram or photo the question is asked about. Served from /uploads.
  imageUrl     String?
  /// What the image shows, for students who can't see it.
  imageAlt     String?

  /// How it's answered: "choice" (multiple choice) or "numeric" (a typed value
  /// within a tolerance). Null reads as "choice" - the bank predates the field.
  answerType   String?

  // Multiple choice. Empty on a numeric question.
  options      String[] // Array of options
  correctIndex Int?

  // Numeric answers. The unit is shown beside the input rather than typed, so a
  // student is never marked wrong for writing "kt" instead of "knots".
  answerValue   Float?
  answerUnit    String?
  /// How far out an answer may be: a percentage of the value, or a flat amount.
  tolerance     Float?
  /// "percent" | "absolute"
  toleranceType String?

  explanation  String

  // Authoring workflow. All optional so existing rows need no backfill -
  // a missing status is treated as "published" (see lib/question-validation.ts).
  status       String?   // "draft" | "review" | "published" | "rejected"
  authorId     String?   @db.ObjectId
  reviewedById String?   @db.ObjectId
  authorNote   String?
  /// Royalty points (Contractor Agreement 3.4): 1 standard, 3 complex. Null reads as 1.
  points       Int?
  /// Why an admin sent it back, or discarded a proposed edit. Cleared when the
  /// curator resubmits. rejectionForId is whoever the feedback is for.
  rejectionReason String?
  rejectedAt      DateTime?
  rejectionForId  String?  @db.ObjectId
  /// Set when an admin asks for changes to a proposed edit. The proposal stays
  /// with the curator (out of the review queue) until they send it again.
  changesRequestedAt DateTime?

  // Review workflow (lib/staff.ts). Edits a curator makes to live content are
  // held here as proposed changes until an admin applies or discards them.
  pendingRevision     Json?
  pendingRevisionById String?   @db.ObjectId
  pendingRevisionAt   DateTime?

  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt

  @@index([subjectId])
  @@index([topic])
  @@index([status])
  @@index([authorId])
}

model Waitlist {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique
  // Confirmed by SMS code when joining. Optional: earlier sign-ups gave email only.
  phone           String?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
}

model RtoContact {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String
  phone        String?
  organisation String
  contacted    Boolean  @default(false) // Track if partnerships team has followed up
  notes        String?  // For internal notes
  createdAt    DateTime @default(now())
  
  @@index([email])
  @@index([createdAt])
}

model Coupon {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  code            String    @unique
  discountPercent Int       // Percentage off (0-100)
  maxUses         Int?      // Null = unlimited
  usedCount       Int       @default(0)
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  
  // Optional: restrict to specific products
  applicableProducts String[] // Product IDs it can be applied to, empty = all
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ForumCategory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  slug        String   @unique
  order       Int      @default(0)
  
  forums      Forum[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Forum {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  slug        String   @unique
  order       Int      @default(0)
  
  categoryId  String   @db.ObjectId
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  threads     Thread[]
  protected   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([categoryId])
}

model Thread {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  
  forumId     String   @db.ObjectId
  forum       Forum    @relation(fields: [forumId], references: [id], onDelete: Cascade)
  
  authorId    String   @db.ObjectId
  author      User     @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  isSticky    Boolean  @default(false)
  isClosed    Boolean  @default(false)
  viewCount   Int      @default(0)
  deleted     Boolean  @default(false)
  
  posts       Post[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([forumId, slug])
  @@index([forumId])
  @@index([authorId])
  @@index([createdAt])
}

model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  
  threadId    String   @db.ObjectId
  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  
  authorId    String   @db.ObjectId
  author      User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  
  replyToId   String?  @db.ObjectId
  replyTo     Post?    @relation("PostReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Post[]   @relation("PostReplies")
  
  isFirstPost Boolean  @default(false) // The opening post of a thread
  editedAt    DateTime? // Track when posts are edited
  deleted     Boolean  @default(false)
  reactions   Reaction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([threadId])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String   // "heart", "thumbsup", "fire", "sparkles"
  
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
}

model PrivateMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  
  senderId    String   @db.ObjectId
  sender      User     @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId  String   @db.ObjectId
  receiver    User     @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  
  isRead      Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Course {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  subjectId       String   // Links to subject from lib/subjects.ts
  title           String
  description     String
  thumbnail       String?
  
  // Course structure
  estimatedHours  Int      @default(1)
  difficulty      String   @default("beginner") // "beginner", "intermediate", "advanced"
  
  // Ordering
  order           Int      @default(0)
  
  // Status
  isPublished     Boolean  @default(false)
  // Unpublished course review: "review" once submitted, "changes" when an admin
  // asks for changes, "rejected" when declined. Cleared on publish.
  reviewStatus    String?
  /// Who created it, for attribution and review.
  authorId        String?   @db.ObjectId
  /// Who last submitted it for review, and when.
  submittedById   String?   @db.ObjectId
  submittedAt     DateTime?
  /// Latest admin feedback; see Question.rejectionReason.
  rejectionReason String?
  rejectedAt      DateTime?
  rejectionForId  String?   @db.ObjectId
  changesRequestedAt DateTime?

  // Review workflow (lib/staff.ts). Edits a curator makes to live content are
  // held here as proposed changes until an admin applies or discards them.
  pendingRevision     Json?
  pendingRevisionById String?   @db.ObjectId
  pendingRevisionAt   DateTime?
  
  modules         Module[]
  enrollments     CourseEnrollment[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([subjectId])
}

model Module {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String   @db.ObjectId
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  order       Int      @default(0)
  
  lessons     Lesson[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([courseId])
}

model Lesson {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  moduleId    String   @db.ObjectId
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  order       Int      @default(0)
  
  // Content type: "text", "video", "quiz", "interactive", "flashcards"
  contentType String   @default("text")
  
  // Content stored as JSON for flexibility
  // For text: { html: "..." }
  // For video: { url: "...", duration: 120 }
  // For quiz: { questions: [...] }
  // For interactive: { type: "diagram|calculator|simulator", config: {...} }
  // For flashcards: { cards: [{ front: "...", back: "..." }] }
  content     Json
  
  // Estimated time in minutes
  estimatedMins Int    @default(5)

  /// Who created it. Lessons earn 10 royalty points while their course is live.
  authorId        String?   @db.ObjectId
  /// Why an admin discarded a proposed edit; see Question.rejectionReason.
  rejectionReason String?
  rejectedAt      DateTime?
  rejectionForId  String?   @db.ObjectId
  /// See Question.changesRequestedAt.
  changesRequestedAt DateTime?

  // Review workflow (lib/staff.ts). Edits a curator makes to live content are
  // held here as proposed changes until an admin applies or discards them.
  pendingRevision     Json?
  pendingRevisionById String?   @db.ObjectId
  pendingRevisionAt   DateTime?
  
  progress    LessonProgress[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([moduleId])
}

model CourseEnrollment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  courseId    String   @db.ObjectId
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  // Progress tracking
  completedLessons String[] @db.ObjectId // Array of completed lesson IDs
  lastAccessedAt   DateTime @default(now())
  
  // Completion
  isCompleted      Boolean  @default(false)
  completedAt      DateTime?
  
  enrolledAt       DateTime @default(now())
  
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  lessonId    String   @db.ObjectId
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  // Progress data stored as JSON (quiz scores, time spent, etc.)
  progressData Json?
  
  // Completion status
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  
  // Time tracking
  timeSpentSecs Int     @default(0)
  
  startedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model StripeProductMapping {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  internalProductId String   @unique // Our internal product ID from products.ts
  stripeProductId   String   // Stripe product ID
  stripePriceId     String   // Stripe price ID
  productName       String
  priceInCents      Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  
  type        String   // "course_enrolled", "exam_completed", "course_completed", "purchase", "message", "achievement"
  title       String
  message     String
  
  // Optional metadata for linking
  link        String?  // URL to navigate to
  imageUrl    String?  // Icon or image
  metadata    Json?    // Additional data like courseId, examId, etc.
  
  isRead      Boolean  @default(false)
  readAt      DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
  @@index([isRead])
}

/// One-time SMS codes (lib/otp.ts). Codes are stored hashed, never in plain text.
model OtpCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /// "signup" | "login" | "reset" | "delete" | "waitlist" | "curator-join" | "curator-login"
  purpose   String
  /// Who the code is for within the purpose: a user id, or the phone at sign-up.
  key       String
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  /// Used, replaced by a newer code, or burned by too many attempts.
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([purpose, key, createdAt])
}

/// Site-wide switches managed from the admin panel (lib/site-settings.ts).
model SiteSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  updatedById String?  @db.ObjectId
  updatedAt   DateTime @updatedAt
}

/// Part 61 MOS Schedule 3 units, loaded from lib/mos/data/schedule3.json (lib/mos/library.ts).
model MosUnit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// "1.3.2" in the loaded compilation. CASA can renumber units, so this isn't the identity.
  number      String
  /// "1" | "2" | "3". Codes are unique within an appendix (AAGA appears in 1 and 2),
  /// so appendix + code identifies a unit across compilations.
  appendix    String?
  code        String
  title       String
  section     String
  /// "rpl" | "ppl" | "cpl" | "atpl" | "irex" | "fe" | "rating"
  licence     String
  reserved    Boolean  @default(false)
  order       Int      @default(0)
  compilation String?
  /// No longer in the loaded compilation.
  retired     Boolean?
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([number])
}

/// The mappable level of Schedule 3: a lettered paragraph, or an element that has none.
model MosItem {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  /// Stable identifier assigned when the item first appeared. Never rewritten: the
  /// item's current position lives in appendix/unitCode/ref, which a MOS update may change.
  key            String    @unique
  appendix       String?
  unitNumber     String
  unitCode       String
  /// "2.1.1(a)"
  ref            String
  topicNumber    String
  topicTitle     String
  subtopicNumber String
  subtopicTitle  String
  elementNumber  String
  elementText    String
  /// The paragraph's own words ("" when the element has no paragraphs).
  text           String
  /// Stem and paragraph together, readable on its own.
  fullText       String
  order          Int       @default(0)
  compilation    String?
  retired        Boolean?
  /// Admin decision: not assessable on its own (e.g. a list other paragraphs refer to).
  excluded       Boolean?
  excludedReason String?
  excludedById   String?   @db.ObjectId

  /// Compilation this item first appeared in.
  introducedIn   String?
  /// Earlier positions and wording, newest last: [{ compilation, unitCode, ref, fullText, change, at }].
  history        Json?

  embedding      Float[]
  embeddingModel String?
  /// Hash of the text that was embedded, so edits to the library re-embed.
  embeddedHash   String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([unitNumber])
}

/// A curator-confirmed link from a question or lesson to a Schedule 3 item.
model MosMapping {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId      String   @db.ObjectId
  /// "question" | "lesson"
  contentType String
  contentId   String   @db.ObjectId
  subjectId   String
  /// Each mapped question or lesson has exactly one primary item.
  primary     Boolean  @default(false)
  /// "suggested" (confirmed from an AI suggestion) | "manual"
  source      String
  /// Suggestion score at the time it was confirmed, 0-1.
  confidence  Float?
  createdById String?  @db.ObjectId
  createdAt   DateTime @default(now())

  // Set by a MOS update when this link may no longer fit (lib/mos/library.ts).
  // The link keeps counting while it's reviewed, unless its item was removed.
  needsReview      Boolean?
  /// "reworded" | "removed"
  reviewReason     String?
  reviewNote       String?
  /// Likely replacements when the item was removed, best first.
  suggestedItemIds String[]  @db.ObjectId
  flaggedAt        DateTime?
  reviewedById     String?   @db.ObjectId
  reviewedAt       DateTime?

  @@unique([contentType, contentId, itemId])
  @@index([needsReview])
  @@index([itemId])
  @@index([subjectId])
  @@index([contentType, contentId])
}

/// One applied update of the Schedule 3 library, kept as an audit trail.
model MosRevision {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  compilation     String?
  registered      String?
  /// Build stamp of the data file that was applied.
  builtAt         String
  fromCompilation String?
  unchanged       Int
  moved           Int
  reworded        Int
  added           Int
  removed         Int
  restored        Int
  /// Links flagged for review by this update.
  flaggedLinks    Int
  /// Per-item changes (capped), for the record.
  changes         Json?
  appliedById     String   @db.ObjectId
  appliedAt       DateTime @default(now())

  @@index([appliedAt])
}

/// Content curators. Deliberately separate from User: curators sign in on
/// curators.aviprep.com.au with their own session, never have a student
/// account, and only reach the content studio (lib/staff.ts).
model Curator {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  /// E.164 Australian mobile. Every sign-in texts a code here.
  phone           String
  phoneVerifiedAt DateTime
  /// Aviation credentials picked at sign-up (lib/curators/details.ts CREDENTIALS).
  credentials     String[]  @default([])
  /// Shown beside their work to students. Served from our own uploads.
  profilePicture  String?
  /// True hides their name and picture from students. Null (the default) shows them.
  anonymous       Boolean?

  // Payment details, set by an admin (Curators > Payment details). Used for
  // royalty statements and RCTIs (lib/finance).
  /// Name on invoices: their legal name, or their business's.
  legalName         String?
  tradingName       String?
  address           String?
  /// "abn" | "hobby" (Statement by a supplier, NAT 3346) | "no-abn" (47% withheld over $75). Null: not set up.
  taxStatus         String?
  /// 11 digits, no spaces.
  abn               String?
  gstRegistered     Boolean?
  /// When the hobby form was received, if taxStatus is "hobby".
  hobbyFormAt       DateTime?
  /// When both parties signed the RCTI agreement. RCTIs aren't issued without it.
  rctiAgreementAt   DateTime?
  paymentNotes      String?

  // Stripe. AviPrep never stores bank details: curators add them to their own
  // Stripe connected account, and royalties are paid by transfer to it. The
  // fields below are a cache of what Stripe reports (lib/finance/connect.ts),
  // with the account number cut down to its last four digits.
  stripeCustomerId       String?
  /// Stripe Identity (KYC). Required before payouts.
  /// "requires_input" | "processing" | "verified" | "canceled"
  identitySessionId      String?
  identityStatus         String?
  identityVerifiedAt     DateTime?
  /// Why the last attempt didn't pass, in Stripe's words.
  identityError          String?
  stripeAccountId        String?
  stripeDetailsSubmitted Boolean?
  stripePayoutsEnabled   Boolean?
  /// Onboarding items Stripe still needs from them.
  stripeRequirementsDue  Int?
  stripeBankName         String?
  stripeBankLast4        String?
  stripeSyncedAt         DateTime?
  /// Deactivated curators can't sign in, and live sessions stop working.
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?

  // Presence, for the admin roster. The studio sends a heartbeat while a
  // curator has it open, so "online" means online rather than "has an account".
  lastSeenAt      DateTime?
  /// What they're on: "question" | "course" | "lesson" | "mos" | "review" | "earnings" | "account" | "home".
  activityKind    String?
  /// The human version, e.g. "Writing a question · CPL Aerodynamics".
  activityLabel   String?

  invitedById     String?   @db.ObjectId
  signedDocuments SignedDocument[]

  /// The member account this curator uses for the community: the forums and
  /// private messages belong to members, so a curator joins them as one rather
  /// than as a second class of person. Linked to an existing account where they
  /// already have one. No relation: it's looked up on its own, and a relation
  /// here would need a unique index Prisma only creates on `db push`.
  userId          String?   @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// An emailed invitation to create a Curator account. Only a hash of the link
/// token is stored; a resend issues a new link and retires the old one.
model CuratorInvite {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  email       String
  firstName   String?
  lastName    String?
  phone       String?
  /// Optional personal note shown in the email and on the join page.
  note        String?
  tokenHash   String    @unique
  invitedById String    @db.ObjectId
  expiresAt   DateTime
  sentAt      DateTime  @default(now())
  sendCount   Int       @default(1)
  acceptedAt  DateTime?
  revokedAt   DateTime?
  curatorId   String?   @db.ObjectId
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// The review timeline for a course, lesson or question: submissions, comments
/// and decisions, in order. Shown on the admin review page and to the curator.
model ReviewEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// "question" | "lesson" | "course"
  contentType String
  contentId   String   @db.ObjectId
  /// "new" (unpublished content) or "edit" (a proposed change to live content).
  kind        String
  /// "submitted" | "comment" | "approved" | "changes-requested" | "rejected"
  action      String
  /// A User id (admin) or Curator id (curator).
  actorId     String   @db.ObjectId
  actorRole   String
  message     String?
  /// On an approved edit: points credited to its proposer, or 0 for a minor edit.
  points      Int?
  createdAt   DateTime @default(now())

  @@index([contentType, contentId, createdAt])
  @@index([actorId])
}

/// Extra royalty points and attribution for a curator whose edit to someone
/// else's work was approved as more than a minor fix. The author's own points
/// aren't stored here: they come from the content (Question.points, 10 per lesson).
/// Counts only while the content is live (lib/curators/royalties.ts).
model ContentCredit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// "question" | "lesson" | "course"
  contentType String
  contentId   String   @db.ObjectId
  curatorId   String   @db.ObjectId
  points      Int
  awardedById String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([contentType, contentId])
  @@index([curatorId])
}

/// A curator's royalty statement for one month, frozen when generated so what
/// was sent never changes. Also the source for their RCTI (lib/finance).
model RoyaltyStatement {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  curatorId      String    @db.ObjectId
  /// "2026-09": the calendar month (Australia/Sydney) the royalties are for.
  period         String
  /// Statement and invoice number, e.g. "AVP-202609-003".
  number         String    @unique
  /// "draft" | "sent" | "paid" | "void"
  status         String    @default("draft")
  /// Per-subject lines, supplier and payment details as they were when generated.
  snapshot       Json
  royaltyCents   Int
  gstCents       Int
  withholdingCents Int
  payableCents   Int
  /// "rcti" (tax invoice), "rci" (recipient created invoice, no GST), or "none" (payment statement only).
  invoiceKind    String
  /// Null when generated by the monthly job.
  generatedById  String?   @db.ObjectId
  generatedAt    DateTime  @default(now())
  autoGenerated  Boolean?
  sentAt         DateTime?
  sentTo         String?
  paidAt         DateTime?
  paymentReference String?
  /// The Stripe transfer that paid it, and the last failure if a transfer didn't go through.
  stripeTransferId String?
  transferError  String?
  voidedAt       DateTime?

  @@unique([curatorId, period])
  @@index([period])
}

/// One run of a scheduled job. The lock is the _id, derived from the key, so a
/// job runs once however many server instances are checking (lib/jobs.ts).
model JobRun {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  /// e.g. "statements:2026-09"
  key        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  result     Json?

  @@index([key])
}

/// A contractor document a curator has filled in and signed on the platform.
///
/// The record is the evidence: what they were shown (template kind + version),
/// what they typed, their drawn signature, when, from where, and a SHA-256 of
/// the exact PDF produced. `seal` is an HMAC over all of that, so a row that has
/// been edited in the database afterwards no longer verifies.
model SignedDocument {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  curatorId  String   @db.ObjectId
  curator    Curator  @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  /// "contractor-agreement" | "rcti-agreement" | "supplier-statement"
  kind       String
  /// The template version signed. Old signatures keep their own wording.
  version    String
  title      String
  /// The field values, as typed.
  values     Json
  /// Their drawn signature, as a PNG data URL.
  signatureImage String
  /// The name they typed under the signature.
  signerName String
  signedAt   DateTime @default(now())
  ip         String?
  userAgent  String?
  /// Their OTP-verified mobile at the moment of signing.
  phone      String?
  /// SHA-256 (hex) of the PDF bytes generated and stored.
  documentHash String
  /// SHA-256 (hex) of any source document incorporated by reference.
  sourceHash String?
  seal       String
  /// Where the generated PDF lives, as a /uploads/... URL.
  pdfUrl     String
  /// Set when an admin voids a signature (superseded, signed in error).
  voidedAt   DateTime?
  voidReason String?
  createdAt  DateTime @default(now())

  @@index([curatorId, kind])
  @@index([signedAt])
}

/// A diagram drawn in the studio: charts, circuit patterns, navaid layouts.
///
/// The scene is the source of truth and stays editable; `pngUrl` is a flat
/// render of it, published so a question or a lesson can point at an image
/// without knowing anything about diagrams.
model Diagram {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  /// Which subject it belongs to, for finding it again. Blank means general.
  subjectId String?
  /// The document (lib/diagrams/scene.ts). Read through readScene(), never raw.
  scene     Json
  width     Int      @default(1200)
  height    Int      @default(675)
  /// The last published render, as a /uploads URL.
  pngUrl    String?
  publishedAt DateTime?
  /// Whoever drew it: an admin User id or a Curator id, like the rest of the
  /// content workflow.
  authorId  String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([updatedAt])
}
