# ---------------------------------------------------------------------------
# AviPrep environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# MongoDB connection string. Used by Prisma (prisma/schema.prisma) and by the
# raw MongoClient in the AI generation routes / scripts/embed.ts (db "vectors").
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/aviprep?retryWrites=true&w=majority"

# Auth ----------------------------------------------------------------------
# Signing key for session JWTs (lib/auth.ts, middleware.ts). Minimum 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Seals signed contractor documents (lib/agreements/seal.ts). The seal is an
# HMAC over the signature record, so a row edited in the database afterwards
# stops verifying. Never rotate this once anything has been signed: every
# existing signature would fail its check.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DOCUMENT_SIGNING_SECRET=""

# Stripe --------------------------------------------------------------------
# Secret key used server-side (lib/stripe.ts).
STRIPE_SECRET_KEY="sk_test_..."
# Publishable key exposed to the browser (app/dashboard/checkout).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret (app/api/webhooks/stripe). Optional in development —
# when unset, webhook events are accepted without signature verification.
STRIPE_WEBHOOK_SECRET="whsec_..."

# reCAPTCHA (v3) ------------------------------------------------------------
# Server-side verification secret (waitlist + RTO contact routes).
RECAPTCHA_SECRET_KEY=""
# Site key exposed to the browser (components/meta/recaptcha-provider.tsx).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""

# Email ---------------------------------------------------------------------
# Google Workspace app password for joshua@aviprep.com.au, used by the
# nodemailer SMTP relay transport in lib/email.ts.
GMAIL_APP_PASSWORD=""

# AI ------------------------------------------------------------------------
# The admin question/content generation routes and scripts/embed.ts call the AI
# SDK with gateway model ids ("openai/gpt-4o", "openai/text-embedding-3-small"),
# which resolve through the Vercel AI Gateway. Not needed when deployed on
# Vercel with OIDC auth enabled.
AI_GATEWAY_API_KEY=""

# The model AviPrep Intelligence reviews submitted questions with
# (lib/review/ai-reviewer.ts). Any gateway model id. Defaults to openai/gpt-4o.
AI_REVIEW_MODEL=""

# Site ----------------------------------------------------------------------
# Canonical origin used for sitemap.xml and robots.txt.
# Defaults to https://aviprep.com.au when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:8001"

# Media ---------------------------------------------------------------------
# Where admin-generated course card art is written (app/api/admin/branding).
# Defaults to public/uploads/course-art, which a stock `next start` serves at
# /uploads/course-art/... Point this at a mounted volume to keep media out of
# the deploy artifact - it must still resolve inside public/ to be served.
# NOTE: this is local disk. Running more than one app server needs shared
# storage (NFS / a mounted volume both nodes see), or images saved on one node
# will 404 on the others.
UPLOAD_DIR=

# SMS (ClickSend) ----------------------------------------------------------
# One-time codes for sign-up, login, password reset and account closure
# (lib/sms.ts, lib/otp.ts). ClickSend uses HTTP Basic auth: account username +
# API key (Dashboard > Developers > API Credentials). When unset in
# development, codes are printed to the server console instead of sent.
CLICKSEND_USERNAME=""
CLICKSEND_API_KEY=""
# Alphanumeric sender ID shown on the SMS (max 11 characters).
CLICKSEND_SENDER="AviPrep"

# Uploads ------------------------------------------------------------------
# Where user uploads (avatars, forum/lesson images, course art) are written.
# Served by app/uploads/[...path] so new files appear without a restart.
# Defaults to ./storage/uploads; use a persistent volume in production.
UPLOAD_DIR=""
